@startuml
' Diagrama de Casos de Uso - notação UML (renderizar com PlantUML: https://www.plantuml.com/plantuml)
left to right direction
skinparam packageStyle rectangle

actor "Administrador / RH\n(nível 1)" as RH
actor "Financeiro\n(nível 2)" as FIN
actor "Colaborador\n(nível 3)" as COL

rectangle "Sistema de Folha de Pagamento" {
  usecase "UC001 Cadastrar Colaborador" as UC001
  usecase "UC002 Consultar Colaboradores" as UC002
  usecase "UC003 Gerar / Consultar Folha" as UC003
  usecase "UC004 Emitir Resumo da Folha" as UC004
  usecase "UC005 Alterar Colaborador" as UC005
  usecase "UC006 Desabilitar / Reativar" as UC006
  usecase "UC007 Redefinir Senha" as UC007
  usecase "UC008 Autenticar-se" as UC008
  usecase "UC009 Alterar a Própria Senha" as UC009
  usecase "UC010 Lançar Vendas e Produção" as UC010
  usecase "UC011 Fechar Folha do Mês" as UC011
  usecase "UC012 Consultar Minha Folha / Recibo" as UC012
}

RH -- UC001
RH -- UC002
RH -- UC003
RH -- UC004
RH -- UC005
RH -- UC006
RH -- UC007
RH -- UC010
RH -- UC011
FIN -- UC002
FIN -- UC003
FIN -- UC004

RH -- UC008
FIN -- UC008
COL -- UC008
RH -- UC009
FIN -- UC009
COL -- UC009
RH -- UC012
FIN -- UC012
COL -- UC012

UC001 .> UC008 : <<include>>
UC010 .> UC008 : <<include>>
@enduml
